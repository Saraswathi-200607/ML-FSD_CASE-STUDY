# Copy this file to ".env" for local development:   copy .env.example .env
# NEVER commit the real .env file.

DEBUG=True
# Generate your own:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to use SQLite. On Render this is the PostgreSQL URL.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# Where model.joblib lives (default: ./model_artifacts). On Render with a persistent disk: /var/data/models
# MODEL_DIR=

# Only needed if your deployed site is on a custom domain:
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
